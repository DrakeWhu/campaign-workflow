{
  "schema_version": 1,
  "optimizer": {
    "command": [
      "python",
      "-m",
      "campaign_optimizer.cli.run_iteration",
      "--config",
      "{optimizer_config}",
      "--iteration",
      "{next_iteration}",
      "--build-candidate-batch"
    ],
    "optimizer_config": "optimizer.json",
    "working_directory": "{optimization_root}",
    "env_script": "~/apps/env/campaign-optimizer.sh"
  },
  "campaign_preparation": {
    "optimizer_runs_dir": "optimizer_runs",
    "iterations_dir": "iterations",
    "template_campaign_root": "iterations/iter_000",
    "campaign_name_template": "multichannel_honeycomb_3d_energy_soft_v2_iter_{next_iteration:03d}",
    "materialize_after_prepare": true,
    "init_case_states_after_materialize": true
  },
  "policy": {
    "max_iterations": 12,
    "max_total_materialized_cases": 80,
    "max_total_submitted_cases": 80,
    "max_cases_per_submit": 9,
    "max_unsubmitted_materialized_cases": 9,
    "require_all_materialized_cases_submitted": true,
    "min_reduced_valid_to_continue": 1,
    "min_valid_fraction_to_continue": 1.0,
    "max_failed_fraction_to_continue": 0.0
  },
  "guards": {
    "enabled": true,
    "pause_file": "PAUSE_OPTIMIZATION",
    "campaign_size": {
      "enabled": true,
      "max_iterations": 12,
      "max_total_materialized_cases": 80,
      "max_total_submitted_cases": 80,
      "max_cases_per_submit": 9,
      "max_unsubmitted_materialized_cases": 9
    },
    "quota": {
      "enabled": true,
      "mode": "hard",
      "hard_used_fraction": 0.95,
      "soft_used_fraction": 0.9,
      "min_free_bytes": 100000000000
    },
    "walltime": {
      "enabled": false,
      "mode": "warn",
      "max_runtime_fraction": 0.85,
      "partition_time_limit_seconds": 21600
    }
  },
  "stopping": {
    "enabled": true,
    "mode": "hard",
    "max_iterations": 12,
    "hypervolume_plateau": {
      "enabled": false
    },
    "candidate_novelty": {
      "enabled": false
    },
    "manual_review": {
      "enabled": false
    },
    "weak_batch": {
      "enabled": false
    }
  }
}
